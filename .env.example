# Enterprise LLM Semantic Caching & TokenOps Gateway Configuration

# Server Settings
PROJECT_NAME="Enterprise LLM Semantic Caching & TokenOps Gateway"
VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Redis Vector Store & Semantic Caching
REDIS_URL=redis://localhost:6379
REDIS_INDEX_NAME=idx:llm_semantic_cache
REDIS_PREFIX=cache:llm:
VECTOR_DIMENSION=1536
SIMILARITY_THRESHOLD=0.88
CACHE_TTL_SECONDS=86400
CACHE_ENABLED=true

# Embedding Provider (options: openai, deterministic)
# "deterministic" is a zero-latency, offline feature hashing embedding for local dev & testing
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Intelligent Model-Tiering Router
ROUTING_ENABLED=true
DEFAULT_BASELINE_MODEL=gpt-4o
TIER_1_MODEL=gpt-4o-mini
TIER_2_MODEL=gpt-4o
TIER_3_MODEL=o1-mini

# Routing Thresholds
TIER_1_MAX_TOKENS=500
TIER_2_MAX_TOKENS=2500
COMPLEXITY_THRESHOLD_TIER2=0.35
COMPLEXITY_THRESHOLD_TIER3=0.70

# Upstream LLM Provider (options: openai, mock)
UPSTREAM_PROVIDER=mock
UPSTREAM_TIMEOUT_SECONDS=30.0
UPSTREAM_MAX_RETRIES=3
